# Domain-based HTTP entry. Copy delivery-platform-app.inc.template to
# /etc/nginx/snippets/delivery-platform-app.inc before enabling this file.
# Replace every __PLACEHOLDER__. Add the same include to the existing HTTPS
# server after its certificate directives.
server {
    listen 80;
    server_name __PUBLIC_HOSTNAME__ __INTERNAL_HOSTNAME__;

    include /etc/nginx/snippets/delivery-platform-app.inc;
}
