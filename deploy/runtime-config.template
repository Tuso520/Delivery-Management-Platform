# Copy this file on each server to /srv/delivery-platform/config/runtime.env,
# replace every <...> value, then chmod 600. Never commit the completed file.

DATA_PROJECT_NAME=delivery-platform-<test-or-production>-data
APP_PROJECT_NAME=delivery-platform-<test-or-production>-app
DATA_NETWORK_NAME=delivery-platform-<test-or-production>-data
MYSQL_VOLUME_NAME=delivery-platform-<test-or-production>-mysql
REDIS_VOLUME_NAME=delivery-platform-<test-or-production>-redis
MINIO_VOLUME_NAME=delivery-platform-<test-or-production>-minio

MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=delivery_platform
MYSQL_USER=delivery_user
MYSQL_ROOT_PASSWORD=<REQUIRED_RANDOM_MYSQL_ROOT_PASSWORD>
MYSQL_USER_PASSWORD=<REQUIRED_RANDOM_MYSQL_USER_PASSWORD>
MYSQL_HOST_PORT=3306

REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=<REQUIRED_RANDOM_REDIS_PASSWORD>
REDIS_HOST_PORT=6379

MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-07-21T05-28-08Z
MINIO_ROOT_USER=<REQUIRED_RANDOM_MINIO_USER>
MINIO_ROOT_PASSWORD=<REQUIRED_RANDOM_MINIO_PASSWORD>
MINIO_BUCKET=delivery-platform
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

BACKEND_HOST_PORT=3000
CORS_ORIGIN=<REQUIRED_PUBLIC_HTTPS_ORIGIN>
JWT_SECRET=<REQUIRED_RANDOM_JWT_SECRET>
JWT_EXPIRES_IN=8h
INTEGRATION_SECRET_ENCRYPTION_KEY=<REQUIRED_RANDOM_32_BYTE_BASE64_KEY>

INTEGRATION_SECRET_MIGRATION_ACTOR_USERNAME=admin
SEED_RESET_EXISTING_USER_PASSWORDS=false
SEED_INCLUDE_DEMO_DATA=false
SEED_ADMIN_PASSWORD=<REQUIRED_INITIAL_OR_ROTATION_ADMIN_PASSWORD>
SEED_DEFAULT_PASSWORD=<REQUIRED_INITIAL_OR_ROTATION_DEFAULT_PASSWORD>

ONLYOFFICE_DOCS_URL=
ONLYOFFICE_JWT_SECRET=
FILE_CONVERTER_URL=
FILE_CONVERTER_TOKEN=
FILE_CONVERTER_TIMEOUT_MS=120000
FILE_CONVERTER_MAX_OUTPUT_BYTES=524288000
FILE_PROCESSING_MAX_ATTEMPTS=3
FILE_PROCESSING_LEASE_MS=300000
FILE_PROCESSING_RETRY_BASE_MS=5000
FILE_PROCESSING_RETRY_MAX_MS=900000
